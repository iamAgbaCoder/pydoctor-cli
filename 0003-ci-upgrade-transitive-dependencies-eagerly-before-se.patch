From 293d500173d5106bf0b76f18d1aa48cb71a2b5eb Mon Sep 17 00:00:00 2001
From: Claude <noreply@example.com>
Date: Sat, 24 Oct 2026 13:08:51 +0000
Subject: [PATCH 3/3] ci: upgrade transitive dependencies eagerly before
 self-diagnosis

Runner images can ship stale packages (e.g. an old certifi) that pip
leaves in place because they already satisfy requirements. Eager
upgrades make the self-diagnosis scan a fresh environment.
---
 .github/workflows/publish.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/publish.yml b/.github/workflows/publish.yml
index d6a03ad..458ad9e 100644
--- a/.github/workflows/publish.yml
+++ b/.github/workflows/publish.yml
@@ -33,7 +33,7 @@ jobs:
       - name: Install dependencies
         run: |
           python -m pip install --upgrade pip setuptools wheel
-          pip install -e ".[dev]"
+          pip install --upgrade --upgrade-strategy eager -e ".[dev]"
 
       - name: Lint and Format Check
         run: |
-- 
