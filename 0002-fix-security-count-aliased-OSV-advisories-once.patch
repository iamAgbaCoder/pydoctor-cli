From d7bd065c1f9bbf20d2a6921a4e36f1ed408ed77c Mon Sep 17 00:00:00 2001
From: Claude <noreply@example.com>
Date: Sat, 24 Oct 2026 13:08:51 +0000
Subject: [PATCH 2/3] fix(security): count aliased OSV advisories once

OSV can return the same advisory under several IDs (e.g. a GHSA and a
PYSEC record that alias each other). Each copy was reported and
penalised separately, so one vulnerability cost the score twice.
Records for the same package and version are now merged when their
IDs or aliases overlap, keeping the highest severity.
---
 pydoctor/scanners/vulnerability_scanner.py | 39 +++++++++++++++++++++-
 tests/test_vulnerability_scanner.py        | 35 +++++++++++++++++++
 2 files changed, 73 insertions(+), 1 deletion(-)

diff --git a/pydoctor/scanners/vulnerability_scanner.py b/pydoctor/scanners/vulnerability_scanner.py
index cd5d1f3..0d412ce 100644
--- a/pydoctor/scanners/vulnerability_scanner.py
+++ b/pydoctor/scanners/vulnerability_scanner.py
@@ -50,7 +50,7 @@ def scan(ctx: ProjectContext) -> list[Issue]:
     client = OSVClient(cache=cache)
 
     # Query OSV for all installed packages
-    records = client.query_packages(ctx.installed_packages)
+    records = _dedupe_records(client.query_packages(ctx.installed_packages))
     failed = list(getattr(client, "failed_packages", []) or [])
 
     issues: list[Issue] = []
@@ -98,6 +98,43 @@ def scan(ctx: ProjectContext) -> list[Issue]:
     return issues
 
 
+_SEVERITY_RANK = {"CRITICAL": 4, "HIGH": 3, "MEDIUM": 2, "LOW": 1, "UNKNOWN": 0}
+
+
+def _dedupe_records(records: list[VulnerabilityRecord]) -> list[VulnerabilityRecord]:
+    """
+    Collapse records that describe the same advisory.
+
+    OSV often returns one advisory under several databases (for example a
+    GHSA entry and a PYSEC entry that list each other as aliases). Without
+    this step each copy is reported and penalised separately, so a single
+    vulnerability can cost the health score twice. Records for the same
+    package and version are merged when their IDs or aliases overlap; the
+    highest severity among the duplicates is kept.
+    """
+    kept: list[VulnerabilityRecord] = []
+    kept_ids: list[set[str]] = []
+    for rec in records:
+        ids = {rec.vuln_id, *rec.aliases}
+        for idx, existing in enumerate(kept):
+            if (
+                existing.package == rec.package
+                and existing.version == rec.version
+                and kept_ids[idx] & ids
+            ):
+                kept_ids[idx] |= ids
+                if _SEVERITY_RANK.get(rec.severity.upper(), 0) > _SEVERITY_RANK.get(
+                    existing.severity.upper(), 0
+                ):
+                    existing.severity = rec.severity
+                existing.aliases = sorted(kept_ids[idx] - {existing.vuln_id})
+                break
+        else:
+            kept.append(rec)
+            kept_ids.append(ids)
+    return kept
+
+
 def _incomplete_scan_issue(failed: list[str], total: int) -> Issue:
     """Build the ERROR issue reported when OSV lookups did not complete."""
     preview = ", ".join(sorted(failed)[:5])
diff --git a/tests/test_vulnerability_scanner.py b/tests/test_vulnerability_scanner.py
index eb4bdb2..1b1f260 100644
--- a/tests/test_vulnerability_scanner.py
+++ b/tests/test_vulnerability_scanner.py
@@ -120,3 +120,38 @@ def test_osv_client_records_failed_packages(monkeypatch, tmp_path):
     records = client.query_packages({"requests": "2.31.0"})
     assert records == []
     assert client.failed_packages == ["requests"]
+
+
+def test_aliased_advisories_reported_once(basic_ctx, monkeypatch):
+    """A GHSA and a PYSEC record that alias each other count as one vulnerability."""
+
+    class FakeClient:
+        def __init__(self, **kwargs):
+            self.failed_packages = []
+
+        def query_packages(self, pkgs):
+            return [
+                VulnerabilityRecord(
+                    vuln_id="GHSA-6q48-6c7w-9gw2",
+                    package="certifi",
+                    version="2026.7.22",
+                    summary="certifi bundles emSign roots with compromised keys",
+                    severity="HIGH",
+                    aliases=["PYSEC-2026-4320"],
+                ),
+                VulnerabilityRecord(
+                    vuln_id="PYSEC-2026-4320",
+                    package="certifi",
+                    version="2026.7.22",
+                    summary="certifi bundles emSign roots with compromised keys",
+                    severity="CRITICAL",
+                    aliases=["GHSA-6q48-6c7w-9gw2"],
+                ),
+            ]
+
+    monkeypatch.setattr("pydoctor.scanners.vulnerability_scanner.OSVClient", FakeClient)
+
+    issues = vulnerability_scanner.scan(basic_ctx)
+    vulns = [i for i in issues if i.code == "SEC_VULNERABILITY"]
+    assert len(vulns) == 1
+    assert vulns[0].severity == Severity.CRITICAL
